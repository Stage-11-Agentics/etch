# Go build artifacts (the Python PoC ./entire-agent-etch is tracked separately)
entire-agent-etch-go

# Local WIP buffer staging dir — written when dogfooding Etch on this repo.
# Session records live in git refs (refs/etch/sessions/), never as tracked files.
# settings.json is carved out: it carries the per-repo hostname salt and is
# meant to be committed so all clones share it (ETCH-37).
.etch/*
!.etch/settings.json

# Transient orchestration scratch — delegator prompt staging, never durable.
.lattice/tmp-prompts/
